{
  "name": "Axi0net",
  "version": "1.0.0",
  "private": true,
  "description": "Yehsa / Axi0net experimental offline symbolic agent in an Expo React Native shell. Root package is CommonJS so require() scripts load. ESM stays in .mjs files and in symbolic/ and yesha_modules/.",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "yesha": "node yesha_modules/yesha.js",
    "trainer": "bash run_trainer.sh",
    "mesh:http": "node symbolic/symbolic_server.mjs",
    "mesh:tcp": "node symbolic/symbolic_watchdog_server.js",
    "mesh:discover": "node utils/mesh_utils.mjs discover",
    "mesh:join": "node utils/mesh_utils.mjs join",
    "mesh:phone": "node utils/mesh_service.mjs",
    "test:mesh": "node --test --test-concurrency=1 test_ble_mesh_discover.mjs test_device_owner.mjs test_mesh_service.mjs",
    "ask": "node symbolic/ask.js",
    "geo": "node symbolic/geo_cli.js",
    "test:knowledge": "node --test --test-concurrency=1 test_knowledge_answer.mjs test_emotion_wording.mjs test_user_learning.mjs test_landscape_nav.mjs test_phone_shell.mjs test_voice_adapter.mjs test_restore.mjs test_chat_actions.mjs test_model_link.mjs test_learned_notes.mjs test_gps_map.mjs test_map_packs.mjs test_picture_guide.mjs test_dem_tiles.mjs test_peer_chat.mjs",
    "autonomy": "node symbolic/symbolic_autonomy_loop.js",
    "books:ingest": "node symbolic/book_index.js",
    "books:spiritual": "node symbolic/tools/build_spiritual_index.js",
    "dictionary:load": "node symbolic/dictionary_loader.js",
    "dictionary:build": "node symbolic/tools/build_full_dictionary.js",
    "dictionary:phone": "node symbolic/tools/build_phone_dictionary.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.1.3",
    "@expo/vector-icons": "^14.0.0",
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@react-native-async-storage/async-storage": "2.1.2",
    "expo": "^53.0.17",
    "expo-application": "~6.1.5",
    "expo-file-system": "~18.1.11",
    "expo-location": "~18.1.6",
    "expo-secure-store": "~14.2.4",
    "expo-speech": "~13.1.7",
    "expo-speech-recognition": "^2.1.5",
    "expo-splash-screen": "~0.30.10",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~1.11.1",
    "express": "^4.22.3",
    "fast-png": "^6.2.0",
    "maplibre-gl": "^5.6.1",
    "pmtiles": "^3.2.0",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-ble-plx": "3.5.1",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-web": "^0.20.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@expo/cli": "^0.18.0",
    "metro": "0.82.4"
  }
}
